{
  "name": "auto-workflow",
  "productName": "Auto WorkFlow Mr. Huỳnh",
  "version": "1.0.2",
  "description": "Auto WorkFlow - Mr. Huỳnh: mở công cụ WorkFlow Automation, dùng thử miễn phí, mua gói VĨNH VIỄN bằng QR",
  "main": "src/main/main.js",
  "author": "Mr. Huỳnh",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "build": {
    "appId": "com.mrhuynh.autoworkflow",
    "productName": "Auto WorkFlow Mr. Huỳnh",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "win": {
      "icon": "assets/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "AutoWorkflow-Setup-${version}.exe",
      "installerIcon": "assets/icon.ico"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    },
    "dmg": { "title": "Auto WorkFlow", "artifactName": "AutoWorkflow-${version}-${arch}.dmg" },
    "afterSign": "build/adhoc-sign.js"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "updateUrl": "https://active.mrhuynh.net/autoworkflow/v1/app/version"
}
